# ============================================================
# Adaptive Risk-Based Authentication System
# Environment Configuration Template
#
# This file is intended for Docker Compose. Service names
# (mongodb, ai-service) are resolvable inside the compose network.
#
# Instructions:
# 1. Copy this file to ".env":  cp .env.example .env
# 2. Modify values below to suit your environment.
# 3. NEVER commit ".env" to version control.
# ============================================================

# --- Application Settings ---
NODE_ENV=development
PORT=5001

# --- Frontend ---
# Vite build-time variables consumed by the React app (frontend/src/api/axios.js)
# and injected into the frontend container by docker-compose.
VITE_API_URL=http://localhost:5001/api
VITE_AI_SERVICE_URL=http://localhost:8000

# --- Backend ---
BACKEND_PORT=5001
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB) ---
# Inside docker-compose this host is the "mongodb" service.
MONGO_URI=mongodb://mongodb:27017/assure_docs

# --- AI Service ---
# Inside docker-compose this host is the "ai-service" service.
AI_SERVICE_URL=http://ai-service:8000
AI_PORT=8000
AI_MODEL_PATH=./models/login_risk_model.pkl

# --- JWT Authentication ---
# Short-lived access token (bearer) + long-lived opaque refresh token (httpOnly cookie).
JWT_SECRET=replace-with-secure-random-string-32-chars
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# --- Email (SMTP) ---
# Set to true (and fill SMTP_*) to send real emails. Leave false for local dev
# where the OTP is returned as devOtpCode in the API response instead.
REQUIRE_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Assure Docs <noreply@assure-docs.test>

# --- Risk Engine ---
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=61
RISK_CRITICAL_THRESHOLD=81

# --- OTP Configuration ---
# Note: the variable name is OTP_EXPIRES_MINUTES (not OTP_EXPIRY_MINUTES).
OTP_EXPIRES_MINUTES=10
ADMIN_OTP_EXPIRES_MINUTES=10

# --- Admin Signup ---
ADMIN_SIGNUP_KEY=replace-with-secure-admin-key

# --- Logging ---
# debug | http | info | warn | error
LOG_LEVEL=debug

# --- Development ---
DEV_MODE=true