# ============================================================
# Adaptive Risk-Based Authentication System
# Environment Configuration Template
#
# Instructions:
# 1. Copy this file to ".env":  cp .env.example .env
# 2. Modify values below to suit your environment.
# 3. NEVER commit .env to version control.
# ============================================================

# --- Application Settings ---
NODE_ENV=development
PORT=5001

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5001/api
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_ADMIN_SIGNUP_KEY=replace-with-secure-admin-key

# --- Backend ---
BACKEND_PORT=5001
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/risk_auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=risk_auth_db
POSTGRES_PORT=5432

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_PORT=8000
AI_MODEL_PATH=./models/login_risk_model.pkl

# --- JWT Authentication ---
JWT_SECRET=replace-with-secure-random-string-32-chars
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Assure Docs <noreply@assure-docs.test>

# --- Risk Engine ---
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=61
RISK_CRITICAL_THRESHOLD=81

# --- OTP Configuration ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Admin Signup ---
ADMIN_SIGNUP_KEY=replace-with-secure-admin-key

# --- Security ---
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Development ---
DEV_MODE=true