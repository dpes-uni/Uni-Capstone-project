# Copy this file to .env and adjust the values before running the server.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/assure_docs
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assure_docs
MONGO_URI=mongodb://127.0.0.1:27017/assure_docs

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API (Vite dev server default)
CLIENT_URL=http://localhost:5173

# REAL EMAIL DELIVERY — required. OTPs are sent to the user's email inbox.
# Gmail SMTP. Use a Google App Password, NOT your normal Gmail password.
# Do NOT put your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="Assure Docs <yourgmail@gmail.com>"
REQUIRE_SMTP=true

# Admin signup protection. Keep this secret and share it only with approved admins.
ADMIN_SIGNUP_KEY=change-this-admin-signup-key
ADMIN_OTP_EXPIRES_MINUTES=10

# Adaptive MFA / risk engine tuning
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=70
MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=15
OTP_EXPIRES_MINUTES=10

# Optional: used only by `npm run create-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_NAME=Assure Docs Administrator
