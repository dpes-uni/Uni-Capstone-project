# ============================================================
# Adaptive Risk-Based Authentication System
# Environment Configuration Template
#
# This file is intended for running the Node.js backend
# locally (npm run dev). Use the root .env.example for
# Docker Compose, where service names replace localhost.
#
# Instructions:
# 1. Copy this file to ".env":  cp .env.example .env
# 2. Modify values below to suit your environment.
# 3. NEVER commit ".env" to version control.
# ============================================================

# --- Application Settings ---
NODE_ENV=development
PORT=5001

# --- Backend ---
BACKEND_PORT=5001
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB) ---
# Local MongoDB (e.g. mongod on default port, or MongoDB Compass).
MONGO_URI=mongodb://127.0.0.1:27017/assure_docs

# --- AI Service ---
# Local Python AI service (python src/api.py).
AI_SERVICE_URL=http://127.0.0.1:8000
AI_PORT=8000
AI_MODEL_PATH=./models/login_risk_model.pkl

# --- JWT Authentication ---
# Short-lived access token (bearer) + long-lived opaque refresh token (httpOnly cookie).
JWT_SECRET=replace-with-secure-random-string-32-chars
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# --- Email (SMTP) ---
# Set to true (and fill SMTP_*) to send real emails. Leave false for local dev
# where the OTP is returned as devOtpCode in the API response instead.
REQUIRE_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Assure Docs <noreply@assure-docs.test>

# --- Risk Engine ---
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=61
RISK_CRITICAL_THRESHOLD=81

# --- Session Monitoring ---
SESSION_RISK_CONTRIBUTION=15
SESSION_RISK_DECAY_PER_SECOND=0.05
STEP_UP_VERIFY_WINDOW_MS=120000
REAUTH_REQUIRED_WINDOW_MS=600000
REAUTH_COOLDOWN_MS=300000

# --- OTP Configuration ---
# Note: the variable name is OTP_EXPIRES_MINUTES (not OTP_EXPIRY_MINUTES).
OTP_EXPIRES_MINUTES=10
ADMIN_OTP_EXPIRES_MINUTES=10

# --- Admin Signup ---
ADMIN_SIGNUP_KEY=replace-with-secure-admin-key

# --- Frontend Serving (optional) ---
# Enable with SERVE_FRONTEND=true and point FRONTEND_DIST at the build output
# to serve the React production build from the Express server.
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist

# --- Logging ---
# debug | http | info | warn | error
LOG_LEVEL=debug

# --- Development ---
DEV_MODE=true