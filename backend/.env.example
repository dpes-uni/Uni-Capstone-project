# Copy this file to .env and adjust the values before running the server.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/assure_docs
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assure_docs
MONGO_URI=mongodb://127.0.0.1:27017/assure_docs

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API (Vite dev server default)
CLIENT_URL=http://localhost:5173

# Email (optional). If left blank, the API runs in "dev mode": instead of
# sending real emails it prints verification links / OTP codes to the
# backend console AND returns them in the API response so the app is fully
# usable without configuring an SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Assure Docs <no-reply@assuredocs.test>"

# Adaptive MFA / risk engine tuning
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=70
MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=15
OTP_EXPIRES_MINUTES=10
