# ============================================================
# Adaptive Risk-Based Authentication System
# Environment Configuration Template
#
# Instructions:
# 1. Copy this file to ".env":  cp .env.example .env
# 2. Modify values below to suit your environment.
# 3. NEVER commit .env to version control.
# ============================================================

# --- Application Settings ---
NODE_ENV=development
PORT=5001

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5001/api
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_ADMIN_SIGNUP_KEY=replace-with-secure-admin-key

# --- Backend ---
BACKEND_PORT=5001
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB) ---
MONGO_URI=mongodb://mongodb:27017/assure_docs

# --- AI Service ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_PORT=8000
AI_MODEL_PATH=./models/login_risk_model.pkl

# --- JWT Authentication ---
JWT_SECRET=replace-with-secure-random-string-32-chars
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (SMTP) ---
# Set to true (and fill SMTP_*) to send real emails. Leave false for local dev
# where the OTP is returned as devOtpCode in the API response instead.
REQUIRE_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Assure Docs <noreply@assure-docs.test>

# --- Risk Engine ---
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=61
RISK_CRITICAL_THRESHOLD=81

# --- OTP Configuration ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Admin Signup ---
ADMIN_SIGNUP_KEY=replace-with-secure-admin-key

# --- Security ---
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Logging ---
# debug | http | info | warn | error
LOG_LEVEL=debug

# --- Development ---
DEV_MODE=true